{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableRemoteControlForAllSessions": true,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true
  },
  "env": {
    "GEMINI_CLI_TRUST_WORKSPACE": "true",
    "ECO_MODE": "0",
    "QWEN_MODEL": "qwen3.5:7b-instruct",
    "OLLAMA_HOST": "http://localhost:11434"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-personal-info.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files-bash.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__list_recent_files|mcp__.*__search_files|mcp__.*__read_file_content|mcp__.*__download_file_content|mcp__.*__get_file_metadata|mcp__.*__get_file_permissions|mcp__.*__copy_file|mcp__.*__create_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/eco-mode-drive.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-gemini-setup.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-multi-llm-setup.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-gh-setup.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-hermes-setup.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-context.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/setup-op.sh >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-claudemd-nudge.sh\""
          }
        ]
      }
    ]
  }
}
