# 1Password 経由で Gemini API キーを注入するための env ファイル雛形
#
# 使い方:
#   1. このファイルを .env.gemini にコピー（.gitignore 済み）:
#        cp .env.gemini.example .env.gemini
#   2. OP_SERVICE_ACCOUNT_TOKEN を .claude/settings.local.json の env に設定
#   3. scripts/gemini-call.sh から自動で参照される
#      （内部で `op run --env-file=.env.gemini -- gemini ...` を実行）
#
# 値は op:// 形式の secret reference。op run が実行時に解決して環境変数として注入する。
# Vault / Item 名はテンプレ標準: claude-code-secrets / Gemini API Key (Template)

GEMINI_API_KEY="op://claude-code-secrets/Gemini API Key (Template)/credential"
